# Pony Games settings.
# Copy this file to ".env" in the site root and fill it in. Never commit .env:
# it holds passwords (it's in .gitignore, and nginx refuses to serve it).
#
# One setting per line: NAME=value. Lines starting with # are comments; a
# " # ..." after a value is a comment too. Put a value in "quotes" if it
# contains " #" itself.

# ---------------------------------------------------------------- the site

# The address of this site, without a slash at the end. Used for links in
# emails sent by the daily summary (cron) and in the sitemap.
# Live: https://pony.games   
SITE_URL=https://pony.games

# A long random string, used to hash IP addresses and visitor ids and to sign
# the "turn off these emails" links. Make one with:  openssl rand -hex 32
# Keep it the same once the site is live: changing it resets everyone's
# anonymous likes and makes old "turn off" links stop working.
HASH_SALT=

# The owner password for /admin/ (works besides the admin accounts).
# Store only the hash, made with:
#   php -r 'echo password_hash("your-password", PASSWORD_DEFAULT), PHP_EOL;'
# Put it in quotes: the hash contains $ signs.
ADMIN_PASSWORD_HASH=''

# Where the database with accounts, reviews, discussions and stats lives
# (uploads/ and backups/ are made next to it). PHP must be able to write
# there. Back it up! It must never be downloadable:
# - empty = ../ponygames-data/community.sqlite, next to (outside) the website
#   folder. On aaPanel, add that folder to open_basedir (.user.ini).
# - or inside the website folder, in storage/, ONLY together with the nginx
#   rule  location ^~ /storage/ { deny all; }  (see deploy/nginx-ponygames.conf):
#   COMMUNITY_DB=/www/wwwroot/pony.games/storage/community.sqlite
COMMUNITY_DB=

# ---------------------------------------------------------------- email
# Needed to confirm new accounts, reset passwords and send the daily summary.
# Without SMTP_HOST and MAIL_FROM no mail is sent at all.

SMTP_HOST=smtp.example.com
# 587 with tls (most providers), 465 with ssl, or none for a local relay
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pony Games <noreply@pony.games>

# New accounts must click the link in their email before they can post.
# 0 turns that check off (e.g. while mail isn't set up yet).
REQUIRE_EMAIL_CONFIRM=1

# ---------------------------------------------------------------- Google Sheet sync
# Keeps a tab of the Google Sheet up to date with the game list (see the
# README, "Google Sheet tab", and tools/google-sheet-sync.gs).
# Leave the URL empty to switch the sync off.

# The web app address of the Apps Script (ends in /exec)
SHEET_WEBHOOK_URL=
# The same secret as in the Apps Script
SHEET_WEBHOOK_SECRET=
# The name of the tab it writes to
SHEET_TAB=site

# ---------------------------------------------------------------- GitHub webhook (webhook.php)
# webhook.php runs "git pull" when GitHub sends a push. It reads these from
# the server's environment variables (PHP-FPM pool / aaPanel), NOT from this
# file. Listed here so you know they exist:
#   GITHUB_WEBHOOK_SECRET=   the secret set in the GitHub webhook
#   REPO_PATH=/www/wwwroot/pony.games
#   BRANCH=main
#   LOG_FILE=/var/log/webhook.log
